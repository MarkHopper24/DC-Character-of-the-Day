{% assign dc_has_character = false %}
{% if Name != blank %}{% assign dc_has_character = true %}{% endif %}
{% assign dc_stale = false %}
{% if UpdatedAt != blank %}
  {% assign dc_updated_seconds = UpdatedAt | date: '%s' | plus: 0 %}
  {% assign dc_now_seconds = 'now' | date: '%s' | plus: 0 %}
  {% assign dc_age_seconds = dc_now_seconds | minus: dc_updated_seconds %}
  {% if dc_age_seconds > 172800 %}{% assign dc_stale = true %}{% endif %}
{% endif %}
{% assign dc_qr_url = QRCodeURL | default: 'https://raw.githubusercontent.com/MarkHopper24/DC-Character-of-the-Day/refs/heads/main/characterQR.jpg' %}
{% capture dc_state %}
  {% if Status == 'error' or status == 'error' %}
    <span class="title" data-clamp="2">Unable to update</span>
    <span class="description" data-clamp="3">{{ ErrorMessage | default: 'The data source is unavailable. The next update will retry.' | escape }}</span>
  {% elsif Status == 'loading' or status == 'loading' %}
    <span class="title" data-clamp="2">Waiting for the first character</span>
    <span class="description" data-clamp="3">The daily DC character will appear after the first successful update.</span>
  {% else %}
    <span class="title" data-clamp="2">No character available</span>
    <span class="description" data-clamp="3">A DC Comics character will appear after the next successful update.</span>
  {% endif %}
{% endcapture %}
<style>
  .dc-card, .dc-card * { min-width: 0; }
  .dc-card .dc-portrait { min-height: 0; overflow: hidden; flex: 1; }
  .dc-card .dc-portrait img { width: 100%; height: 100%; max-height: 100%; object-fit: contain; }
  .dc-card .dc-body { min-height: 0; flex: 1; overflow: hidden; }
  .dc-card .dc-details { min-height: 0; }
  .dc-card .dc-qr { flex: none; }
  .dc-brand { font-weight: 800; }
</style>

<style>.dc-card.layout--col > * {flex:0 0 auto}.dc-card.layout--col > .dc-portrait,.dc-card.layout--col > .stretch-y {flex:1 1 0;min-height:0}.dc-card .dc-qr-wrap {flex:none}</style>

<style>
.dc-card [data-clamp] {display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:var(--dc-lines,2);overflow:hidden}
.dc-card [data-clamp="1"] {--dc-lines:1}
.dc-card [data-clamp="3"] {--dc-lines:3}
.dc-card [data-clamp="11"] {--dc-lines:11}
.screen--lg .dc-card [data-clamp-lg="5"] {--dc-lines:5}
.screen--lg .dc-card [data-clamp-lg="16"] {--dc-lines:16}
</style>
